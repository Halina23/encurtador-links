# Modelo de configuração. Para usar:
#   cp .env.example .env
# e troque os valores. O .env NÃO vai para o Git.

# --- Banco de dados ---
POSTGRES_USER=encurtador
# Use só letras e números: a senha entra na URL de conexão.
# Para gerar uma: openssl rand -hex 16
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=encurtador

# --- Aplicação ---
# Endereço público usado para montar os links curtos.
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Porta da sua máquina onde a aplicação fica acessível.
APP_PORT=8000
